<mxfile host="app.diagrams.net"><diagram name="Architecture" id="arch"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1940" pageHeight="780"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b style=&quot;font-size:20px&quot;&gt;Predictive Maintenance MLOps Pipeline (AI4I 2020)&lt;/b&gt;&lt;br&gt;Goal: predict &lt;b&gt;Machine failure&lt;/b&gt; (binary; 339 of 10,000 = 3.39% positive) from machine sensor readings. Repo: Kohei-Uehara-VIP/predictive-maintenance-mlops" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1800" height="60" as="geometry" /></mxCell><mxCell id="docker" value="Docker container (Day 3)" style="rounded=1;dashed=1;fillColor=none;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=2;fontColor=#b85450;html=1;" vertex="1" parent="1"><mxGeometry x="1195" y="82" width="310" height="208" as="geometry" /></mxCell><mxCell id="notes" value="&lt;b&gt;Retraining loop:&lt;/b&gt; Prefect (daily) &amp;#8594; Evidently drift check &amp;#8594; if drift, retrain (2) &amp;#8594; new model logged and registered in MLflow (3) &amp;#8594; API serves the Production model (4).&lt;br&gt;&lt;b&gt;Day 5:&lt;/b&gt; &lt;i&gt;docker-compose up&lt;/i&gt; starts API, MLflow, Prefect, Prometheus and Grafana with one command." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="665" width="1840" height="50" as="geometry" /></mxCell><mxCell id="data" value="&lt;b style=&quot;font-size:13px&quot;&gt;1. Data Ingestion&lt;/b&gt; &lt;i&gt;(Day 1)&lt;/i&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;What:&lt;/b&gt; Download AI4I 2020 CSV from the official UCI page and validate it&lt;br&gt;&lt;b&gt;Why:&lt;/b&gt; One reproducible, documented data source&lt;br&gt;&lt;b&gt;How:&lt;/b&gt; curl + unzip into data/ (git-ignored); check columns (UDI, ...), 10,000 rows, no missing values&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="280" height="165" as="geometry" /></mxCell><mxCell id="train" value="&lt;b style=&quot;font-size:13px&quot;&gt;2. Training Pipeline&lt;/b&gt; &lt;i&gt;(Day 2)&lt;/i&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;What:&lt;/b&gt; Preprocess data and train Random Forest and XGBoost&lt;br&gt;&lt;b&gt;Why:&lt;/b&gt; Same preprocessing at training and serving time; fair model comparison&lt;br&gt;&lt;b&gt;How:&lt;/b&gt; sklearn Pipeline: scale 5 numeric columns, one-hot encode Type; drop UDI, Product ID and TWF-RNF (leakage)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="110" width="280" height="165" as="geometry" /></mxCell><mxCell id="mlflow" value="&lt;b style=&quot;font-size:13px&quot;&gt;3. MLflow&lt;/b&gt; &lt;i&gt;(Day 2)&lt;/i&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;What:&lt;/b&gt; Track experiments and register the best model&lt;br&gt;&lt;b&gt;Why:&lt;/b&gt; Every run is comparable and reproducible&lt;br&gt;&lt;b&gt;How:&lt;/b&gt; Log params, Recall / PR-AUC / F1 and plots; register best model as Production&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="280" height="165" as="geometry" /></mxCell><mxCell id="api" value="&lt;b style=&quot;font-size:13px&quot;&gt;4. FastAPI Service&lt;/b&gt; &lt;i&gt;(Day 3)&lt;/i&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;What:&lt;/b&gt; POST /predict returns failure probability&lt;br&gt;&lt;b&gt;Why:&lt;/b&gt; Makes the model usable by other systems&lt;br&gt;&lt;b&gt;How:&lt;/b&gt; Pydantic validates inputs; loads Production model from MLflow at startup; exposes /metrics&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1210" y="110" width="280" height="165" as="geometry" /></mxCell><mxCell id="client" value="&lt;b style=&quot;font-size:13px&quot;&gt;Client&lt;/b&gt; &lt;i&gt;(Day 3)&lt;/i&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;What:&lt;/b&gt; Sends machine sensor readings&lt;br&gt;&lt;b&gt;Why:&lt;/b&gt; Simulates a factory system calling the API&lt;br&gt;&lt;b&gt;How:&lt;/b&gt; cURL / HTTP requests with JSON body&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1600" y="110" width="280" height="165" as="geometry" /></mxCell><mxCell id="prod" value="&lt;b style=&quot;font-size:13px&quot;&gt;Simulated Production Data&lt;/b&gt; &lt;i&gt;(Day 4)&lt;/i&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;What:&lt;/b&gt; Holdout data with injected shifts&lt;br&gt;&lt;b&gt;Why:&lt;/b&gt; Creates a realistic drift scenario&lt;br&gt;&lt;b&gt;How:&lt;/b&gt; Add noise / shift values (e.g. higher air temperature)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="280" height="165" as="geometry" /></mxCell><mxCell id="evid" value="&lt;b style=&quot;font-size:13px&quot;&gt;5. Evidently AI&lt;/b&gt; &lt;i&gt;(Day 4)&lt;/i&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;What:&lt;/b&gt; Data drift test suite&lt;br&gt;&lt;b&gt;Why:&lt;/b&gt; Detects when production data differs from training data&lt;br&gt;&lt;b&gt;How:&lt;/b&gt; Compare current (production) data against reference (training) data&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="470" width="280" height="165" as="geometry" /></mxCell><mxCell id="prefect" value="&lt;b style=&quot;font-size:13px&quot;&gt;6. Prefect&lt;/b&gt; &lt;i&gt;(Day 4)&lt;/i&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;What:&lt;/b&gt; Scheduled daily retraining flow&lt;br&gt;&lt;b&gt;Why:&lt;/b&gt; Automates monitoring and retraining without manual work&lt;br&gt;&lt;b&gt;How:&lt;/b&gt; (1) run drift check -&amp;gt; (2) if drift: retrain -&amp;gt; new model logged to MLflow&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="470" width="280" height="165" as="geometry" /></mxCell><mxCell id="prom" value="&lt;b style=&quot;font-size:13px&quot;&gt;7. Prometheus&lt;/b&gt; &lt;i&gt;(Day 5)&lt;/i&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;What:&lt;/b&gt; Collects API metrics&lt;br&gt;&lt;b&gt;Why:&lt;/b&gt; Monitors service health (requests, latency, errors)&lt;br&gt;&lt;b&gt;How:&lt;/b&gt; Scrapes the /metrics endpoint at fixed intervals&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1210" y="470" width="280" height="165" as="geometry" /></mxCell><mxCell id="graf" value="&lt;b style=&quot;font-size:13px&quot;&gt;8. Grafana&lt;/b&gt; &lt;i&gt;(Day 5)&lt;/i&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;What:&lt;/b&gt; Dashboard of API metrics&lt;br&gt;&lt;b&gt;Why:&lt;/b&gt; Visual monitoring for operators&lt;br&gt;&lt;b&gt;How:&lt;/b&gt; Queries Prometheus as its data source&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1600" y="470" width="280" height="165" as="geometry" /></mxCell><mxCell id="e0" value="train split" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="data" target="train"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="log runs +&lt;br&gt;register" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="train" target="mlflow"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="load&lt;br&gt;Production model" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mlflow" target="api"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="POST /predict" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="client" target="api"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="holdout split" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="data" target="prod"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="reference data (train split)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="data" target="evid"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="264.0" y="365" /><mxPoint x="514.0" y="365" /></Array></mxGeometry></mxCell><mxCell id="e6" value="current data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prod" target="evid"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="(1) run&lt;br&gt;drift check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prefect" target="evid"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="(2) if drift: retrain" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="prefect" target="train"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="904.0" y="400" /><mxPoint x="654.0" y="400" /></Array></mxGeometry></mxCell><mxCell id="e9" value="scrape /metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="prom" target="api"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prom" target="graf"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>